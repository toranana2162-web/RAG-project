# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ただしテンプレートはコミットする（実値は含めない）
!.env.local.example

# vercel
.vercel

# 精度評価の実データ・結果（社内文書由来のためコミットしない。例ファイルのみ可）
scripts/eval/dataset.json
scripts/eval/results.json

# typescript
*.tsbuildinfo
next-env.d.ts
