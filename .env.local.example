# このファイルはプレースホルダのみ。実際の値は .env.local に記載し、Gitへコミットしないこと。
# .env.local は .gitignore 済み (要件12)。

# --- サイトURL（認証メールのリダイレクト先に使用）---
# ローカル例: http://localhost:3000  本番例: https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (東京リージョン) ---
# クライアントへ公開してよい値（新UIでは Publishable key が anon の後継）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# サーバー専用。クライアントへ絶対に露出させない (要件12)
SUPABASE_SERVICE_ROLE_KEY=

# --- AI ---
# 回答生成 (サーバー専用)
ANTHROPIC_API_KEY=
# Embedding (OpenAI, サーバー専用)
EMBEDDING_API_KEY=

# --- RAG 設定（任意。未設定なら config/rag.ts の初期値を使用）---
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536
# RAG_CHUNK_SIZE_TOKENS=700
# RAG_CHUNK_OVERLAP_TOKENS=120
# RAG_RETRIEVAL_TOP_K=8
# RAG_SIMILARITY_THRESHOLD=0.3
# RAG_MAX_CHUNKS_PER_DOCUMENT=3
# RAG_MAX_UPLOAD_BYTES=20971520

# --- 認証 ---
# 許可する社内メールドメイン（カンマ区切り、例: example.co.jp）
ALLOWED_EMAIL_DOMAINS=
